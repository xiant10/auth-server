# Base URL clients reach this service on. It is also the JWT issuer.
AUTH_PUBLIC_URL=http://localhost:8081
AUTH_LISTEN_ADDR=:8081

DATABASE_URL=postgres://auth:auth-dev-password@localhost:5432/auth?sslmode=disable

# Keeps the password grant for seeded users and opens registration to anyone.
# Refused unless AUTH_PUBLIC_URL is localhost. Outside dev mode, AUTH_PUBLIC_URL
# must be https, and AUTH_SIGNING_KEY_CURRENT and AUTH_TOTP_KEY are required.
AUTH_DEV_MODE=true

# PEM-encoded ES256 keys from `authctl gen-key`. NEXT is published in the JWKS
# ahead of a rotation. In dev mode an unset CURRENT means a throwaway key.
# AUTH_SIGNING_KEY_CURRENT=
# AUTH_SIGNING_KEY_NEXT=

# Reviewed list of OAuth clients.
AUTH_CLIENTS_FILE=clients.yaml

# 32 bytes of base64 from `authctl gen-totp-key`, encrypting stored TOTP secrets.
# Required outside dev mode.
# AUTH_TOTP_KEY=

# Region for phone numbers typed with no country code.
# AUTH_DEFAULT_REGION=CN

# Set behind an ingress that appends the client to X-Forwarded-For. Rate limits
# would otherwise count every user as the ingress.
# AUTH_TRUST_PROXY=true

# server_url handed to clients, and the only copy of the API secret. Outside dev
# mode the secret must be real, with 32 or more characters.
LIVEKIT_URL=ws://localhost:8890
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-32-plus-character-secret
